{
  "name": "weave-calendar-mvp",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "GOALS", "class_name": "DinnerGoal" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DinnerGoal"] }],
}
